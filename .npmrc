# eslint-config-next@16.4.6 bundles eslint-plugin-import, eslint-plugin-jsx-a11y
# and eslint-plugin-react, whose latest versions declare peer support only up to
# ESLint 9. ESLint 10 works (verified: lint, typecheck, build and 700 tests pass)
# but npm warns on install. This suppresses those warnings until the plugins
# release ESLint 10 support.
legacy-peer-deps=true
