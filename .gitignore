# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local mock data layer
.local-db.json
# The end-to-end suite's throwaway database, and Playwright's own output.
.e2e-db.json
/test-results/
/playwright-report/
/blob-report/
/.uploads/
# Snapshots taken before clearing the mock database. They hold whatever guest
# details were typed in while testing, so they never go near the repository.
.local-db.backup-*.json
/public/uploads/

# mail written to disk by the FileMailer when no SMTP credentials are set
.local-mail/

# Camera originals for the website photos (10-18 MB each). The web-sized
# copies the site serves live in public/site/photos/ - see lib/site.ts.
/Images/
public/.~lock.GHM_Invoice.docx#