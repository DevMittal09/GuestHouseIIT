# Copy to .env.local and fill in to run against Supabase.
# Leave everything commented out to use the zero-setup local mock store
# (.local-db.json + public/uploads) — see README.md.

# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Server-only. Required for the developer console's user management
# (creates Supabase Auth users). Never commit the real value.
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
# MAIL_REDIRECT_ALL_TO=
# MAIL_USER=
# MAIL_APP_PASSWORD=