
# ============================================
# Supabase Configuration
# ============================================

# Leave these commented out to run against the zero-setup local mock store
# (.local-db.json + public/uploads).
# Uncomment and fill in the values to switch to Supabase.

# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side Supabase service role key
# NEVER expose this key to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Supabase publishable key (if used by your application)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key


# ============================================
# Email Configuration
# ============================================

# Email address to which all outgoing emails are redirected during testing
MAIL_REDIRECT_ALL_TO=your-test-email@example.com

# Gmail account used for sending emails
MAIL_USER=your-email@gmail.com

# Gmail App Password (16-character app password)
MAIL_APP_PASSWORD=your-gmail-app-password

# Set to true to prevent actual email delivery
MAIL_DRY_RUN=false


# ============================================
# Cron Job Configuration
# ============================================

# Secret used to authenticate cron job requests
CRON_SECRET=your-cron-secret


# ============================================
# Application URLs
# ============================================

# Canonical application base URL
APP_BASE_URL=https://your-app.vercel.app

# Application URL
APP_URL=https://your-app.vercel.app


# ============================================
# Security Configuration
# ============================================

# Base64-encoded encryption key used for ID encryption
ID_ENCRYPTION_KEY=your-base64-encryption-key


# ============================================
# Sign-in
# ============================================

# Google sign-in (OpenID Connect). Set all three — with APP_URL above — and
# the sign-in card's second button becomes the real "Sign in with Google",
# and the mock door at /mock-login stops existing.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# Until Google is configured, that button reads "Mock Authentication" and
# opens the persona picker at /mock-login: one click per portal account, no
# password. Set MOCK_LOGIN=false to close that door without configuring
# Google (LDAP sign-in only).
# MOCK_LOGIN=false

# The legacy developer switch: it keeps the old gh_mock_user cookie working
# outside production. It is no longer needed for /mock-login.
# DEV_LOGIN=true

# The institute LDAP directory. Without LDAP_URL, sign-in checks the dummy
# accounts in lib/ldap/mock-directory.ts (.memories/11-ldap-accounts.md).
# LDAP_URL=ldaps://ldap.iitpkd.ac.in:636
# LDAP_BASE_DN=dc=iitpkd,dc=ac,dc=in
