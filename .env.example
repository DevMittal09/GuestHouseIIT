# ===========================================================================
# IIT Palakkad Guest House Portal - Environment Variables
# ===========================================================================
#
# Copy this file to .env.local and fill in every value.
# The app refuses to start in production if the required variables are missing.
#
# .env.local is gitignored. Never commit real secrets.
# ===========================================================================


# ---- 1. Database (required in production) -----------------------------------
# PostgreSQL connection string. Leave commented out for the zero-setup local
# mock store (.local-db.json).
# DATABASE_URL=postgresql://user:password@localhost:5432/guesthouse

# Set to 'true' if your PostgreSQL requires SSL (remote hosts, cloud providers).
# DATABASE_SSL=true


# ---- 2. Application URL (required in production) ----------------------------
# The public URL of this deployment - used for Google OAuth redirects and
# server-action origin checks. No trailing slash.
# APP_URL=https://guesthouse.iitpkd.ac.in


# ---- 3. Google Sign-in (required for login) ---------------------------------
# OpenID Connect credentials from Google Cloud Console.
# The redirect URI registered in Google must be exactly:
#   ${APP_URL}/api/auth/google/callback
# Full setup guide: GOOGLE-SIGN-IN.md
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# Mock authentication - the account picker at /mock-login, one click per demo
# account and no password. Outside production it is always open, whether or
# not Google is configured. In production it exists only while Google is
# unset, because the sign-in button has to lead somewhere.
#   MOCK_LOGIN=false   closes it outright, anywhere.
# MOCK_LOGIN=true is refused in production - the picker is not authentication.
# MOCK_LOGIN=false


# ---- 4. Email / SMTP (required for notifications) --------------------------
# Gmail account with an App Password (16 characters, spaces stripped).
# Without MAIL_USER the app writes .eml files to .local-mail/ instead.
# MAIL_USER=guesthouse@iitpkd.ac.in
# MAIL_APP_PASSWORD=your-gmail-app-password

# The From address. Defaults to MAIL_USER; Gmail rewrites anything that is
# neither the authenticated account nor an alias verified on it.
# MAIL_FROM=guesthouse@iitpkd.ac.in

# NOTE: an inline "# comment" after a value is part of the value - the env
# loader does not strip it. Put comments on their own line.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_DRY_RUN=true


# ---- 5. Cron secret (required in production) --------------------------------
# Guards /api/mail/cron and /api/mail/dispatch. At least 16 characters.
# CRON_SECRET=change-me-to-a-long-random-string


# ---- 6. Encryption key (required in production) -----------------------------
# Encrypts guests' ID numbers at rest. Generate with:
#   openssl rand -base64 32
# ID_ENCRYPTION_KEY=your-base64-encryption-key


# ---- 7. Optional -------------------------------------------------------------

# Redirect ALL outgoing email to one address (staging/testing ONLY).
# LEAVE UNSET IN PRODUCTION - it drops CC entirely.
# MAIL_REDIRECT_ALL_TO=your-test-email@example.com

# The only addresses mail may actually reach. Everything else is DROPPED, not
# failed: nothing is attempted and nothing is retried. Most demo accounts have
# addresses that do not exist, and sending to one costs an SMTP rejection, a
# FAILED outbox row and four retries.
#
# A whole address, or @domain for every address at a domain; comma separated.
# This is the one to use when you want to watch the real addressing work -
# unlike MAIL_REDIRECT_ALL_TO it keeps To and CC as they were.
# LEAVE UNSET IN PRODUCTION, where every address is real.
# MAIL_ALLOWED_RECIPIENTS=someone@gmail.com,@iitpkd.ac.in

# Test-only sign-in for e2e tests (set by Playwright, never in production).
# E2E_TEST_SECRET=
